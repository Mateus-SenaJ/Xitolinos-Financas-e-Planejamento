    "deficitCovered": {
      "type": "boolean",
      "default": false
    },
    "reserveWithdrawalCents": {
      "type": "integer",
      "required": false,
      "min": 0
    },
    "savingsWithdrawalCents": {
      "type": "integer",
      "required": false,
      "min": 0
    },
    "investmentWithdrawalCents": {
      "type": "integer",
      "required": false,
      "min": 0
    },
    "notes": {
      "type": "text"
    },
    "confirmedAt": {
      "type": "datetime"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
