{
  "kind": "collectionType",
  "collectionName": "month_closes",
  "info": {
    "singularName": "month-close",
    "pluralName": "month-closes",
    "displayName": "Fechamento mensal",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "month": {
      "type": "string",
      "required": true,
      "maxLength": 7
    },
    "cardPaid": {
      "type": "boolean",
